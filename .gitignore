node_modules/
dist/
target/
.DS_Store

# big slides, stay local
sol/home/school/*/material/*.pptx

# Sol: the browser tool's logins and cookies, and saved attachments
sol/home/browser-profile/
sol/home/voice/
# Sol: how Sol is used, as counts (engine/src/track.ts, #356): the tester code and the day files
sol/home/track/
sol/home/attachments/
# Sol: the stage's blocks and each session's stage.json (#695, engine/src/work/blocks.ts)
sol/home/*/blocks/
sol/home/*/sessions/
sol/home/*/pieces-seen.json
sol/home/*/pieces-trust.json

# Sol: the keeper's copies of the engine build and its try count (engine/launchd/keep)
sol/engine/dist.good/
sol/engine/dist.good.new/
sol/engine/dist.bad/
sol/engine/.keep

# Sol developers' runs: the first-timer's and the morning run's reports (#485), beside the gate's (#481)
.sol-gate/

# Sol: keys (ElevenLabs, Gemini)
sol/engine/.env
# Sol: what sol/setup leaves behind (logs to read when a step failed, a skipped team key)
sol/engine/.setup-*

# Sol: settings and conversation names (written by the engine)
sol/engine/settings.json
sol/engine/models.json
sol/engine/titles.json
sol/engine/doors.json
sol/engine/sticky.json
# Sol: the team settings, each person's own (Together, BUILD.md)
sol/engine/team.json
sol/engine/night.json
sol/engine/team.cloud.json

# Claude Code session lock, machine-local
.claude/scheduled_tasks.lock

# Sol: pages the desk renders from PDFs (remade on demand)
sol/home/desk/pages/

# Sol: the seat's scratch downloads while studying
sol/home/school/*/tmp/

# Sol: the back room's data is each person's own. The instructions stay shared.
sol/home/memory/*
!sol/home/memory/.keep
sol/home/life/*
!sol/home/life/.keep
sol/home/school/
sol/home/jobs/
sol/home/desk/
sol/home/talk/
sol/home/output/
sol/home/tmp/
# a person's own buttons (sol/mac/src/buttons/index.ts takes them in) and their arrangement (engine/src/arrange.ts):
# a new version and a rebase of <you>/mine never touch either
sol/home/buttons/
sol/home/arrangement.json
sol/home/arrangement.bad-*.json
sol/home/arrangement.json.*.tmp
# the sol skill linked for Claude chats by sol/setup (sol/home is each person's own)
sol/home/.claude/skills/
# Anticipate sitting 2: the notch's skill file is each person's own, and a shelf export of someone's words must
# never be one `git add -A` from a commit
sol/home/skills/
sol/home/shelf/

# The harness (sol/harness/guard, .claude/settings.json): what is each person's own stays out
.claude/settings.local.json
.claude/harness.local.json
.claude/worktrees/
sol/engine/.stage/
sol/engine/.live/
sol/engine/.live-build.log
sol/engine/*.before-live
sol/engine/*.before-unlive

# Sol: the saved data's version and the copies taken before each conversion step (engine/src/convert, #422)
sol/home/.sol/

# The gate (#481): its last result per commit and the face build it opened
.sol-gate/

# freeform (#630): a person's things and their own atlas live in the home, never committed; the atlas drawn from the fixture likewise
sol/home/things/
sol/home/atlas.html
# the kernel (#633): the home's log and the data its blocks read and write through the gate
sol/home/log/
sol/home/data/
sol/design/system/fixtures/atlas.html
# Home pass 2 shoots: a shot per flow scene, made on the NucBox, never committed (#692)
sol/design/home/stage/p2/shots/
sol/design/home/stage/p2/tmp/
.sol/pieces/yours-*
sol/home/screens.json
