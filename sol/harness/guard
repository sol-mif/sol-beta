#!/usr/bin/env node
// The harness (#83): what an agent is refused, enforced by the machine.
// Claude Code runs this before every Bash, Edit, Write and MultiEdit call (.claude/settings.json, committed), and on a
// few more calls for the team's locks (#484). It reads the call on stdin and either says nothing (the call goes ahead)
// or refuses it with one plain line.
// Refused: a commit on main; work on another person's branch; a branch made without Take; merging outside a PR
// (a git merge into main, an API merge, gh pr merge --admin, a PR into stable, live or another person's branch), or moving
// stable or live; committing home data or a key; editing the fence from inside a running Sol; a PR without a
// test note; parking the face-hot flag,
// installing, opening or quitting Sol.app, restarting the engine's jobs, moving where Sol lives (#116; #114, the window is the person's). Pressing the review session's card (#416, rule tonight). Sending back by hand (#421, rule sent-back).
// Let through since #1126 (one flow: merge when green, the night checks): gh pr merge of a PR into main or your own
// branch, GitHub's checks being the gate; gh pr ready; a base branch beside another person's.
// #484: a rule judges what a command does, not the words in it, and where it runs (a cd before it, git -C, env -C), not
// where the session started: a commit message, a grep or a PR body that names a rule's words is never the thing itself,
// and a command run inside another (bash -c, $( ), eval, xargs) is judged as itself. In the team's own repository the
// dev cycle's locks are added from sol/locks/team.mjs (not shipped to beta): evals first, eval sealed, no weakening,
// done = green, first-timer sealed and checkpoint, by the session's role (SOL_ROLE, or a sol-<role> agent file).
// It fails closed: a call it cannot read, a line whose quotes do not close or whose program is a variable and that names
// an action it judges (rule unparsed), a team lock file that is there but does not load, or a guard that throws, is
// refused in the team's repository with the reason, never let through in silence.
// Any person can let one through from their own window: .claude/harness.local.json (gitignored),
// {"allow": [{"rule": "merge", "until": "2026-11-20", "why": "…"}]}, names the rule and the day it ends (at most 30
// days after the file was saved; an old plain "merge" works until DEFAULT_UNTIL or 14 days after the file was saved,
// and says so). The guard then says so on stderr and steps aside. Rule names are below. A session never writes that
// file itself (rule let-through): a let-through is the person's.
// In the team's repository every refusal and let-through is one line in locks.jsonl next to Sol's state (counts only: when, rule,
// refused or let through, tool, role), for the team's analytics (#437, fix-at-source's "let through 5 times in a week").
// It also says one thing that is not a refusal (#202, claims): an edit of a file another open PR or another side copy on
// this machine changed gets one line of context for the agent, once per file per session, and the holder's agent is told.
// And `guard --stage` (a UserPromptSubmit hook) gives a session on one of the team's features its stage line every turn.
import { execFileSync, spawn } from "node:child_process";
import { appendFileSync, existsSync, mkdirSync, readFileSync, readdirSync, realpathSync, rmSync, statSync, writeFileSync } from "node:fs";
import { createHash } from "node:crypto";
import { homedir, platform, tmpdir } from "node:os";
import { basename, dirname, isAbsolute, join, relative, resolve } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const TMP = (name, key) => join(tmpdir(), `sol-guard-${name}-${createHash("sha1").update(key).digest("hex").slice(0, 12)}.json`);
const readJson = (file, maxAge = Infinity) => { try { if (Date.now() - statSync(file).mtimeMs < maxAge) return JSON.parse(readFileSync(file, "utf8")); } catch {} return undefined; };
const writeJson = (file, v) => { try { writeFileSync(file, JSON.stringify(v)); } catch {} };
const readText = (f) => { try { return readFileSync(f, "utf8"); } catch { return ""; } };
function gitIn(dir, a, ms) { try { return execFileSync("git", a, { cwd: dir, encoding: "utf8", timeout: ms, stdio: ["ignore", "pipe", "ignore"] }).trim(); } catch { return ""; } }

// ---- a checkout, read from its files (git itself is slow here, and a call may judge three folders); git when unsure
const repos = new Map();
/** a path made real (macOS's /tmp and /var are links; git's roots are real; the disk's own case on a case-insensitive
 *  disk, so A/B/C.MD is a/b/c.md), its missing tail kept */
function real(f) { let d = f, tail = ""; while (d !== dirname(d) && !existsSync(d)) { tail = join(basename(d), tail); d = dirname(d); } try { return join(realpathSync.native(d), tail); } catch { return f; } }
const NONE = { root: "", gitDir: "", common: "" };
/** the checkout a path is in: { root, gitDir, common }, root "" outside one */
function repoAt(p, from = process.cwd()) {
  let d = real(isAbsolute(p) ? p : resolve(from, p));
  const seen = [];
  for (;;) {
    if (repos.has(d)) { const r = repos.get(d); for (const s of seen) repos.set(s, r); return r; }
    seen.push(d);
    const dot = join(d, ".git");
    if (existsSync(dot)) {
      let r = NONE;
      try {
        let gitDir = dot;
        if (!statSync(dot).isDirectory()) { const m = /^gitdir:\s*(.+?)\s*$/m.exec(readText(dot)); gitDir = m ? resolve(d, m[1]) : ""; }
        if (gitDir && existsSync(join(gitDir, "HEAD"))) { const c = readText(join(gitDir, "commondir")).trim(); r = { root: d, gitDir, common: c ? resolve(gitDir, c) : gitDir }; }
      } catch {}
