        const out = gitIn(d, ["rev-parse", "--show-toplevel", "--absolute-git-dir", "--path-format=absolute", "--git-common-dir"]).split("\n");
        r = out[0] ? { root: real(out[0]), gitDir: out[1] ?? "", common: out[2] ?? out[1] ?? "" } : NONE;
      }
      for (const s of seen) repos.set(s, r);
      return r;
    }
    const up = dirname(d);
    if (up === d) { for (const s of seen) repos.set(s, NONE); return NONE; }
    d = up;
  }
}
/** a checkout's settings (its config and the worktree's own), as "section.sub.key" → value */
function configOf(r) {
  if (r.cfg) return r.cfg;
  const cfg = {};
  for (const f of [join(r.common, "config"), join(r.gitDir, "config.worktree")]) {
    let sec = "";
    for (const l of readText(f).split("\n")) {
      const s = /^\s*\[([^\]\s"]+)(?:\s+"([^"]*)")?\s*\]/.exec(l);
      if (s) { sec = s[1].toLowerCase() + (s[2] !== undefined ? "." + s[2] : ""); continue; }
      const kv = /^\s*([A-Za-z][\w-]*)\s*=\s*(.*?)\s*$/.exec(l);
      if (kv && sec) cfg[`${sec}.${kv[1].toLowerCase()}`] = kv[2].replace(/^"(.*)"$/, "$1");
    }
  }
