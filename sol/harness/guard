// ---- the sealed marks, by their effect (#484): before a shell line in the team's repository the guard keeps every feature folder's
// prd.md and eval.md; after it (`guard --after`, a PostToolUse hook) a Scoped or Approved line that appeared and that git
// does not account for (the commit HEAD moved to holds it) is taken out again and the session is told. This catches what
// no reading of the words can: a script, base64, a variable. A commit that brings one is judged at the commit (#482's check)
const SEALED_REL = /^specs\/features\/[^/]+\/(eval|prd)\.md$/i;
