// ---- the --stage mode (#484, a UserPromptSubmit hook): a session on one of the team's features hears, every turn, which of the
// four checkpoints its feature has passed (Scoped → evals approved → gate green → handed in). Says nothing elsewhere.
if (MODE === "stage") {
  const r = repoAt(cwd, cwd);
  const b = branchOf(r);
