let input = {}, unreadable = "";
try { input = JSON.parse(rawIn || "{}"); if (!input || typeof input !== "object" || Array.isArray(input)) throw new Error("not an object"); }
catch (e) { input = {}; unreadable = String(e?.message ?? e).split("\n")[0].slice(0, 120); }
const cwd = typeof input.cwd === "string" && input.cwd ? input.cwd : process.cwd();
