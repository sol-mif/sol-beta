// refuses in every checkout, where a static import would stop the guard before it could say anything
try { ({ solDevIn, SAFE_RULES } = await import("./sol-dev.mjs")); }
catch (e) { failClosed(`its check of which repository this is (sol/harness/sol-dev.mjs) does not load (${String(e?.message ?? e).split("\n")[0].slice(0, 160)}).`, true); }
