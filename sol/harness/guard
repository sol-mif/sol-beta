}
const refreshClaims = (root) => { try { spawn(process.execPath, [process.argv[1], "--refresh-claims", root], { detached: true, stdio: "ignore" }).unref(); } catch {} };

// ---- let-throughs, read before anything can fail (failClosed asks them too)
const DEFAULT_UNTIL = "2026-11-15";   // an old plain entry (no until) works until this day, or 14 days after the file was saved
const DAY = 86_400_000;
