      if (args.includes("--admin")) refuse("merge", MERGE_WHY, [here]);
      // alone on its line: nothing before it may change which repo, host, folder or PR base gh will act on (#1126)
      if (steps.length !== 1 || /\bGH_[A-Z_]+=|^\s*(env|export|sudo|command|exec)\b/.test(x.text) || x.depth > 0)
        refuse("merge", `gh pr merge runs alone on its own line, with no GH_ variable, cd or other command beside it: gh pr merge <n> --merge [-R owner/repo]. ${MERGE_WHY}`, [here]);
      const { base, repo } = prBase(here, { ...h, args });
      const mine = namesAt(here), home = repoSlug(gitIn(here.root, ["remote", "get-url", "origin"]));
      if (!base) refuse("merge", `GitHub did not say which branch that PR goes into, so it is not merged from here. ${MERGE_WHY}`, [here]);
      else if (!home || repo.toLowerCase() !== home.toLowerCase()) refuse("merge", `that PR is in ${repo || "a repository GitHub did not name"}, not this checkout's ${home || "origin"}; only the team's own repository merges from here (the beta repo moves by the export alone). ${MERGE_WHY}`, [here]);
      else if (base !== "main" && !(base.includes("/") && mine.includes(base.split("/")[0]))) refuse("merge", `that PR goes into ${base}, not main nor a branch of yours. ${MERGE_WHY}`, [here]);
    }
    const ends = h.path[0] === "api" ? [h.path[1] ?? "", ...h.args].filter((a) => a && !a.startsWith("-")) : [];   // the endpoint, wherever it sits
    const writesApi = h.path[0] === "api" && /(-X\s*|--method[\s=]+)(PUT|POST|PATCH|DELETE)\b|\s(-f|-F|--field|--raw-field|--input)(\s|=)/i.test(x.text);
    if (ends.some((a) => /(^|\/)pulls\/\d+\/merge\/?$/.test(a)) && /(-X\s*|--method[\s=]+)PUT\b/i.test(x.text)) refuse("merge", MERGE_WHY, [here]);
    if (writesApi && ends.some((a) => /^\/?repos\/[^/]+\/[^/]+\/merges\/?$/.test(a))) refuse("merge", MERGE_WHY, [here]);
    // stable and live by GitHub's API: their ref updated or made, the branch renamed
    if (writesApi && (/\/git\/refs\/heads\/(stable|live)\b|\/branches\/(stable|live)\/rename\b/.test(x.text) || /\bref=refs\/heads\/(stable|live)\b/.test(x.text))) refuse("stable-move", MOVE_WHY, [here]);
    // main takes no commit outside a PR: a setting such as who leads a label is a proposal in the project's settings, and
    // CODEOWNERS follows by a PR the release merges (#438, sol/engine/src/team/codeowners.ts). A write by hand, GitHub's
    // contents or refs API aimed at main (a contents write with no branch lands on main too), is a commit on main and refused.
    // To drop once GitHub's rules are on (#484, decision 14): main-by-api, when main is protected on GitHub itself.
    if (h.path[0] === "api" && /(-X\s*|--method[\s=]+)(PUT|POST|PATCH|DELETE)\b|\s(-f|-F|--field|--raw-field|--input)\s/i.test(x.text)
      && ((/\/contents\//.test(x.text) && (/\bbranch=main\b/.test(x.text) || !/\bbranch=/.test(x.text))) || /\/git\/refs\/heads\/main\b/.test(x.text)))
      refuse("main-by-api", `writing to main through GitHub's API is a commit on main with no PR. A setting (who leads a label) is a proposal in Cowork's project settings, and CODEOWNERS follows by a PR; anything else goes on your branch and a draft PR.`, [here]);
  }

  // base's one open branch at a time (#98) was dropped by #1126: two people build base at once, the claims and the
  // nightly check's conflict comments say where they meet
  const pushes = g?.sub === "push", opens = !!h && h.path[0] === "pr" && h.path[1] === "create";

  // the window is the person's, in both folders (#114): no session parks the face-hot flag, installs or opens or quits
  // Sol.app, or touches the engine's launchd or systemd jobs. The person switches the face from the menu bar; a merge on
  // their word installs a build (the release). A person's own Sol tries its changes on its own stage. A write is one
  // the command does (a redirect, cp, rm …), never a word in a commit message
  const w = writesOf(x);
  const writes = w.writes.length + w.deletes.length + w.appends.length > 0 || /^(rm|mv|cp|touch|chflags|ditto|rsync|install|tee|truncate)$/.test(prog(x));
  if (!g && !h && /face-hot/.test(s) && writes) refuse("window", `the face-hot flag is the person's own switch (the menu bar); a session never parks or restores it.${dev(" MY SOL tries its build on its own stage: bash sol/mine/stage.")}`);
  if (!g && !h && /\bSol\.app\b|\/Applications\b/.test(s) && (writes || /^(open|killall|pkill|osascript|xattr|codesign)$/.test(prog(x)))) refuse("window", `the Sol window is the person's: a session never installs, opens or quits Sol.app. ${solDev ? "A merge on their word installs a build (sol/promote); MY SOL runs on its own stage (sol/mine/stage)." : "A new version comes in with the Update button in Sol's own window, pressed by the person."}`);
  if (/^(open|killall|pkill)\s+(-\S+\s+)*['"]?Sol(\.app)?['"]?$/.test(s) || (/^osascript\b/.test(s) && /\bquit\b/.test(s) && /\bSol\b/.test(s))) refuse("window", `the Sol window is the person's: a session never opens or quits it.${dev(" MY SOL runs on its own stage (sol/mine/stage).")}`);
  if (/^launchctl\s+(kickstart|stop|bootout|unload|kill|remove|disable)\b.*\bsol-engine|^systemctl\s+(--user\s+)?(restart|stop|kill|disable)\b.*\bsol-engine/.test(s)) refuse("window", `the engine renews itself after a saved build; a session never restarts or stops it (that ends the session mid-turn). When it is truly stuck, one line for the person: bash sol/back.`);
  if (/^(?:(?:bash|sh|zsh|exec)\s+(?!-n\b))?\S*\bmine\/(?:un)?live\b/.test(s) && !/\s--plan\b/.test(s)) refuse("window", solDev ? `sol/mine/live and unlive move the Sol the person lives in (its engine, its jobs, Sol.app) and stop this very engine on the way; only the person runs them, in Terminal.app. Leave them the one line.`
    : `that moves the Sol the person lives in (its engine, its jobs, Sol.app) and stops this very engine on the way; only the person runs it, in Terminal.app. Leave them the one line.`);

  // from a side copy, the live checkout's build is not mine to run (#119 near miss: a scratch Vite started in the live
  // sol/mac rewrote the hot face's cache under the window): a build or dev server run in the main checkout (after a cd
  // into it) or named by its path is refused; the side copy has its own sol/mac and sol/engine, and a copy that lives
  // under the main checkout's folder is its own.
  if (root && mainRoot && root !== mainRoot && /\b(vite|tsc|npm\s+(run|ci|install|start)|npx|node\s+\S*(vite|tsc))\b/.test(s)
      && (repoAt(x.dir, cwd).root === mainRoot || s.includes(mainRoot + "/sol/")))
    refuse("window", `that is the live checkout's build (${mainRoot}/sol); ${solDev ? "a side copy runs its own sol/mac and sol/engine, and the stage (sol/mine/stage) for a whole second Sol." : "a worktree runs its own sol/mac and sol/engine."}`);

  // the fence, from a shell
  if (insideSol && (writes || /\bsed\s+-i/.test(s))) {
    const named = [...w.writes, ...w.deletes, ...w.appends].find((f) => isFenced(f)) ?? (s.match(/[\w./-]+\.(tsx?|css)/g) || []).find((f) => isFenced(f, x.dir));
    if (named) refuse("fence", `${basename(named)} is on the fence and is never changed from inside a running Sol.`);
  }

  // a PR says what to try, for the person who will try it: its body as gh will send it (a --body, a --body-file, written
  // earlier in the same line or not, a heredoc), never the words around it
  if (opens && here.root) {
    const base = flag(h.args, "--base", "-B"), head = flag(h.args, "--head", "-H");
    // a --head that is on GitHub only (no local branch) is judged as GitHub has it, origin/<head> (#1159)
    const remoteOnly = (b) => !/[*?[\]$`]/.test(b) && !gitIn(here.root, ["rev-parse", "-q", "--verify", `refs/heads/${b}`]) && gitIn(here.root, ["rev-parse", "-q", "--verify", `refs/remotes/origin/${b}^{commit}`]) ? `refs/remotes/origin/${b}` : b;
    const marked = unrecordedMarks(here, head && !head.includes(":") ? remoteOnly(head) : (tb && tb !== UNKNOWN ? tb : "HEAD"), base, k);
    if (marked) refuse("eval-sealed", marked, [here]);
  }
  if (opens) {
    let body = null;
    const bf = flag(h.args, "--body-file", "-F"), b = flag(h.args, "--body", "-b");
    // what gh reads as its stdin: a heredoc, a file redirected in (< file), or the command piped into it
    const stdinFile = (() => { const ws = x.words; for (let i = 0; i < ws.length; i++) if (ws[i].op && ws[i].t === "<" && ws[i + 1]) return pathFrom(h.dir, ws[i + 1].t); return ""; })();
    if (bf !== undefined) {
      const earlier = (f) => steps.slice(0, k).filter((y) => { const yw = writesOf(y); return [...yw.writes, ...yw.appends].includes(f); }).map((y) => [...y.docs, y.text].join("\n")).join("\n");
      // piped in from a plain cat of one file: that file
      const prev = k > 0 && steps[k - 1].pipe === x.pipe ? steps[k - 1] : null;
      const catFile = prev && prog(prev) === "cat" && prev.prog.length === 2 && !/[$`*?]/.test(prev.prog[1].t) ? readText(pathFrom(prev.dir, prev.prog[1].t)) : "";
      if (bf === "-") body = [...x.docs, ...(stdinFile ? [readText(stdinFile)] : []), catFile, ...(k > 0 ? [steps[k - 1].text, ...steps[k - 1].docs] : [])].join("\n");
      else { const f = pathFrom(h.dir, bf); body = readText(f) + "\n" + earlier(f); }
    } else if (b !== undefined) {
      const cat = /^\$\(\s*cat\s+(['"]?)([^'"\s<)]+)\1\s*\)$/.exec(b.trim());
      body = cat ? readText(pathFrom(h.dir, cat[2])) : [b, ...x.docs].join("\n");
      if (!cat && b.includes("$") && !/what to try/i.test(body) && /what to try/i.test(line)) body = line;   // a body the shell builds from its own words: the line, as before
    }
    // --fill takes the body from the branch's commits; --template from the template it names (or the repo's one)
    if (body === null && h.args.some((a) => /^(--fill|-f|--fill-verbose|--fill-first)$/.test(a)))
      body = gitIn(here.root, ["log", "--format=%B", `${gitIn(here.root, ["rev-parse", "-q", "--verify", "origin/main"]) ? "origin/main" : "main"}..HEAD`], 8000);
    const tpl = flag(h.args, "--template", "-T");
    if (body === null && tpl !== undefined) {
      const named = [join(here.root, ".github", "PULL_REQUEST_TEMPLATE", tpl), join(here.root, ".github", tpl), pathFrom(h.dir, tpl)];
      body = named.map(readText).find(Boolean) ?? readText(join(here.root, ".github", "PULL_REQUEST_TEMPLATE.md"));
    }
    if (body === null) refuse("pr-without-note", `a PR carries a test note: a body (the template) with "What to try" written for the person who will try it, and "Felt or silent".`, [here]);
    if (!/what to try/i.test(body)) refuse("pr-without-note", `the PR body has no test note: a line "What to try" (what to do, what you should notice) for the person who will try it, and "Felt or silent".`, [here]);
  }
}
// GitHub's merge by GraphQL, in a gh api line or a program's code (after the loop, so the git merge refusal reads first)
{
  const MERGE_GQL = /\b(mergePullRequest|enablePullRequestAutoMerge|mergeBranch)\b/;
  const NETS = /^(curl|wget|websocat|wscat|nc|ncat|socat|http|https|xh)$/;
  const inline = (x) => /^(node|nodejs|deno|bun|python|python3|perl|ruby|php|osascript)$/.test(prog(x)) && (x.docs.length > 0 || x.prog.slice(1).some((w) => /^(-e|-c|-p|--eval|--print|eval|-)$/.test(w.t)));
  if (steps.some((x) => { const h = ghOf(x); const t = [x.text, ...x.docs, x.ran ?? ""].join("\n"); return MERGE_GQL.test(t) && ((h && h.path[0] === "api") || NETS.test(prog(x)) || inline(x) || (x.ran !== undefined && !ranOwn(scriptPath(x) || "/"))); }))
    refuse("merge", MERGE_WHY, atAll());
}
process.exit(0);
