/** a person's let-through for `rule` in these checkouts' .claude/harness.local.json: { ok, note } or { ok: false,
 *  expired } or null */
function letThroughIn(dirs, rule) {
  let expired = "";
  for (const f of [...new Set(dirs.filter(Boolean))].map((d) => join(d, ".claude/harness.local.json"))) {
    let local, saved;
    try { local = JSON.parse(readFileSync(f, "utf8")); saved = statSync(f).mtimeMs; } catch { continue; }
    for (const e of Array.isArray(local?.allow) ? local.allow : []) {
      const name = typeof e === "string" ? e : e?.rule;
      if (name !== rule) continue;
      const until = typeof e === "object" && /^\d{4}-\d{2}-\d{2}$/.test(String(e.until ?? "")) ? String(e.until) : "";
      const last = until ? [until, ymd(saved + 30 * DAY)].sort()[0] : [DEFAULT_UNTIL, ymd(saved + 14 * DAY)].sort()[1];
      if (ymd(Date.now()) > last) { expired = last; continue; }
      const note = until ? `until ${last}` : `with no "until": it works until ${last}; write {"rule": "${rule}", "until": "YYYY-MM-DD"} to say how long`;
      return { ok: true, note };
    }
  }
  return expired ? { ok: false, expired } : null;
}

// ---- the call. One the guard cannot read, a file of its own that will not load, or a guard that throws, is refused with
// the reason (rule guard-error, which a person can let through), never let through in silence: in every checkout while
// the guard does not yet know the call's, and once it knows, where the team's rules hold (a team lock file is theirs)
const MODE = process.argv[2] === "--stage" ? "stage" : process.argv[2] === "--after" ? "after" : "pre";
