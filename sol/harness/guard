  const lt = (() => { try { return letThroughIn([r.root], "guard-error"); } catch { return null; } })();
  if (lt?.ok) { process.stderr.write(`harness: guard-error let through by your local override (.claude/harness.local.json), ${lt.note}: ${why}\n`); process.exit(0); }
  process.stdout.write(JSON.stringify({ hookSpecificOutput: { hookEventName: "PreToolUse", permissionDecision: "deny",
    permissionDecisionReason: `harness (guard-error): ${why} The guard cannot judge this call, so it refuses it rather than let it through unread. Tell your human; a person can let guard-error through for a day in .claude/harness.local.json.` } }));
