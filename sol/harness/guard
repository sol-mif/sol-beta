}
const dirtyOf = (r) => !!r.root && !!gitIn(r.root, ["status", "--porcelain", "--untracked-files=normal"], 8000);
const aheadOf = (r) => !!r.root && Number(gitIn(r.root, ["rev-list", "--count", "origin/main..HEAD"], 8000) || gitIn(r.root, ["rev-list", "--count", "main..HEAD"], 8000) || 0) > 0;
/** the main checkout a side copy belongs to (the common .git, one level up) */
const mainRootOf = (r) => (r.common ? real(resolve(r.common, "..")) : "");

// The team's repository or not (#479): the team's rules (Take, the nights, branch names, merging, test notes, claims)
// are for the team's own checkouts. Any other checkout (a Sol tester's, whose remotes are the beta repo, or anyone's)
// keeps only SAFE_RULES, the ones that protect any Sol user: home data, keys, the fence, the window, and their words
// name nothing of the team's. Decided by the checkout's tree and remotes (solDevIn, kept as #479 wrote it); every rule
// not named safe is a team rule. The beta export runs this guard as a tester's before it ships it (leak.ts). #484 asks
// it of every checkout the call acts in, not only the session's (a cd into the team's repository is in it), and
// remembers it: a checkout once seen as the team's stays so for the guard (the seen file in its state folder, outside
// the repo), so a session that changes its remotes or its files by a road the guard does not see keeps the team's
// rules on (fail closed). The roads it does see are refused (rule remote).
// solDevIn and SAFE_RULES come from #479's check beside this file, loaded below once the guard can refuse when it does not load
let solDevIn, SAFE_RULES;
const STATE_DIR = process.env.SOL_STATE ? dirname(process.env.SOL_STATE)
  : platform() === "darwin" ? join(homedir(), "Library", "Application Support", "com.marcol04.sol") : join(homedir(), ".local", "share", "sol");
const SEEN = join(STATE_DIR, "sol-dev-seen.json");
// the press's record (#482, engine/src/team/checkpoint.ts PRESSED): what each Scoped and Approve press wrote, the engine's
const PRESSED_PATH = join(STATE_DIR, "checkpoint", "pressed.jsonl");
const PRESSED_NAMES = [...new Set([PRESSED_PATH, PRESSED_PATH.replace(homedir(), "~"), PRESSED_PATH.replace(homedir(), "$HOME"), PRESSED_PATH.slice(homedir().length + 1)])].filter((x) => x.length > 20);
const pressedNow = () => readText(PRESSED_PATH).split("\n").filter(Boolean).map((l) => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);
/** what a press seals, as a hash: the file up to "## Releases" (the verifier's lines need no new press); #482's sealedHash */
const sealedHash = (t) => createHash("sha256").update(String(t).split(/^## Releases[ \t]*$/m)[0].replace(/\s+$/, "")).digest("hex");
let seen;
const seenNow = () => (seen ??= readJson(SEEN) ?? {});
function isSolDev(r) {
  if (!r.root) return false;
  if (r.dev !== undefined) return r.dev;
  const now = solDevIn(r.root);
  const key = real(r.common ? resolve(r.common, "..") : r.root);
  const was = seenNow()[key] === true;
  if (now && !was) { try { mkdirSync(STATE_DIR, { recursive: true }); const all = { ...seenNow(), [key]: true }; for (const k of Object.keys(all)) if (!existsSync(k)) delete all[k]; writeFileSync(SEEN, JSON.stringify(all)); seen = all; } catch {} }
  return (r.dev = now || was);
}
let teamModule;
/** sol/locks/team.mjs: null where it is not (Sol beta, which never gets it), `{ broken }` where it is and does not load */
async function team() {
  if (teamModule !== undefined) return teamModule;
  const url = new URL("../locks/team.mjs", import.meta.url);
  if (!existsSync(fileURLToPath(url))) return (teamModule = null);
  try { teamModule = await import(url); } catch (e) { teamModule = { broken: String(e?.message ?? e).split("\n")[0].slice(0, 200) }; }
