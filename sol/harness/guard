  return r.branch;
}
/** the commit a checkout stands on */
function headOf(r) {
  if (!r.root) return "";
  const h = readText(join(r.gitDir, "HEAD")).trim();
  if (/^[0-9a-f]{40}$/.test(h)) return h;
  const ref = /^ref: (.+)$/.exec(h)?.[1];
  if (ref) {
    const loose = readText(join(r.common, ref)).trim() || readText(join(r.gitDir, ref)).trim();
    if (/^[0-9a-f]{40}$/.test(loose)) return loose;
    const packed = new RegExp(`^([0-9a-f]{40}) ${ref.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}$`, "m").exec(readText(join(r.common, "packed-refs")));
    if (packed) return packed[1];
  }
