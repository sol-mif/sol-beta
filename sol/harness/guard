// who I am in a checkout: the login gh is signed in as, remembered in .git so the guard never waits on the network twice
function loginAt(r) {
  if (!r.root) return "";
  if (r.login !== undefined) return r.login;
  let l = configOf(r)["sol.login"] || gitIn(r.root, ["config", "--get", "sol.login"]);
  if (!l) { try { l = execFileSync("gh", ["api", "user", "-q", ".login"], { encoding: "utf8", timeout: 8000, stdio: ["ignore", "pipe", "ignore"] }).trim(); if (l) gitIn(r.root, ["config", "sol.login", l]); } catch {} }
  return (r.login = l || "");
}
/** the team's people, the team's pages, <name>.md ("login: x") */
function peopleOf(r) {
  if (r.people) return r.people;
  const out = [];
  const dir = join(r.root, "docs/people");
  try { for (const f of readdirSync(dir)) if (f.endsWith(".md")) out.push({ name: basename(f, ".md"), login: (/^login:\s*(\S+)/m.exec(readText(join(dir, f))) ?? [])[1] ?? "" }); } catch {}
  return (r.people = out);
}
/** my names in a checkout: my login and every people page that says it */
function namesAt(r) {
  const l = loginAt(r); if (!l) return [];
  return [l, ...peopleOf(r).filter((p) => p.login === l).map((p) => p.name)];
}

// ---- the --refresh-claims mode: the slow half of the live claims, run detached by the hook so an edit never waits on
// gh or git. It writes two files: every open PR's files (and whether it is a draft), and the files changed on each other
// side copy (worktree) of this repo against main plus its working tree. A call that fails writes an empty answer.
if (process.argv[2] === "--refresh-claims") {
  const r = process.argv[3];
  const run = (cmd, a, dir, ms) => { try { return execFileSync(cmd, a, { cwd: dir, encoding: "utf8", timeout: ms, stdio: ["ignore", "pipe", "ignore"] }); } catch { return ""; } };
  let prs = [];
  try { prs = JSON.parse(run("gh", ["pr", "list", "--state", "open", "--json", "number,headRefName,author,files,isDraft", "--limit", "100"], r, 15000) || "[]"); } catch {}
  writeJson(TMP("prfiles", r), prs.map((p) => ({ number: p.number, branch: p.headRefName, login: p.author?.login ?? "", draft: p.isDraft === true, files: (p.files ?? []).map((f) => f.path) })));
  const trees = [];
  let cur = {};
  for (const l of (run("git", ["worktree", "list", "--porcelain"], r, 5000) + "\n").split("\n")) {
    if (l.startsWith("worktree ")) cur = { path: l.slice(9) };
    else if (l.startsWith("branch refs/heads/")) cur.branch = l.slice(18);
    else if (l === "") { if (cur.path && cur.branch) trees.push(cur); cur = {}; }
  }
  // a side copy's holder is its branch's prefix, made a GitHub login by the team's page <prefix>.md ("login: x"), else kept
  const loginOf = (prefix) => { try { return (/^login:\s*(\S+)/m.exec(readFileSync(join(r, "docs/people", prefix + ".md"), "utf8")) ?? [])[1] || prefix; } catch { return prefix; } };
  const out = [];
  for (const t of trees) {
    if (resolve(t.path) === resolve(r) || /^(main|stable|live|beta)$/.test(t.branch) || /\/(mine|plan|shots)$/.test(t.branch)) continue;
    const diff = run("git", ["diff", "--name-only", "main...HEAD"], t.path, 5000);
    const status = run("git", ["status", "--porcelain", "--untracked-files=all"], t.path, 5000);
    if (!diff && !status && !existsSync(t.path)) continue;
    const files = new Set([...diff.split("\n"), ...status.split("\n").map((l) => l.slice(3).replace(/^.* -> /, ""))].filter(Boolean));
    out.push({ path: t.path, branch: t.branch, login: t.branch.includes("/") ? loginOf(t.branch.split("/")[0]) : "", files: [...files] });
