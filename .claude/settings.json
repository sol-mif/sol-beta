{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/sol/harness/guard\" || exit 2", "timeout": 20 }]
      },
      {
        "matcher": "Read|Grep|Glob|LS|mcp__sol__mark_done|mcp__sol__hand_in",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/sol/harness/guard\" || exit 2", "timeout": 20 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/sol/harness/guard\" --after || exit 2", "timeout": 20 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/sol/harness/guard\" --stage", "timeout": 20 }]
      }
    ]
  }
}
